<!--  FIX: Layout sebelumnya kosong — tambahkan UI chat dasar  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <!--  Area tampilan pesan  -->
    <ScrollView android:id="@+id/scrollMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp">
        <TextView android:id="@+id/tvMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp"/>
    </ScrollView>
    <!--  Area input pesan  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
        <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Tulis pesan..." android:inputType="textMultiLine" android:maxLines="3"/>
        <Button android:id="@+id/btnSend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Kirim"/>
    </LinearLayout>
</LinearLayout>