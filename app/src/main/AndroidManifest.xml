<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:allowBackup="true" android:icon="@mipmap/ic_launcher" android:label="ECCChat" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.ECCChat">
        <!--  FIX: MainActivity sebagai launcher utama  -->
        <activity android:name=".MainActivity" android:exported="true" android:label="ECCChat" android:theme="@style/Theme.ECCChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--  FIX: Daftarkan LoginActivity agar bisa dibuka lewat Intent  -->
        <activity android:name=".ui.LoginActivity" android:exported="false" android:label="Login"/>
        <!--  FIX: Daftarkan RegisterActivity  -->
        <activity android:name=".ui.RegisterActivity" android:exported="false" android:label="Register"/>
        <!--  FIX: Daftarkan ChatActivity  -->
        <activity android:name=".ui.ChatActivity" android:exported="false" android:label="Chat"/>
    </application>
</manifest>